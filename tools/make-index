#!/usr/bin/env python3
"""Check sources.json and this repo's plugin folders, or write index.json for them offline.

    python3.12 -I tools/make-index                 # check (what a listing PR must pass); writes nothing
    python3.12 -I tools/make-index --sha COMMIT    # write index.json for this repo's folders at COMMIT

sources.json lists what the app's browser shows: {"plugins": [{"repo": "OWNER/REPO", "path": "FOLDER"
(optional), "ref": "TAG" (optional)}], "unlisted": {"FOLDER": "why"}}. The normal way index.json is made is
the GitHub workflow (.github/workflows/index.yml), which runs tools/build_index.py against GitHub and pins
every entry, including other people's repositories, to a commit. This script needs no network:

- check: every row is well formed (the same rules as tools/build_index.py and the app); every row for this
  repository names a folder whose meetko.toml passes the same manifest checks, whose id publisher is the
  repo owner, and whose command needs no build; every plugin folder here is either listed or in "unlisted".
- --sha: index entries for this repository's rows, with manifests read from COMMIT (`git show`, the bytes
  the archive of that commit holds; there is no .gitattributes export-subst here). COMMIT must be on the
  GitHub default branch before the index is published, or installs are refused. Rows for other
  repositories are kept from the current index.json (the workflow makes them).

Stdlib only; Python 3.11 or newer (tomllib, via tools/build_index.py, a copy of meetko's
tools/plugin-index/build_index.py).
"""

from __future__ import annotations

import sys

if sys.version_info < (3, 11):
    raise SystemExit(f"make-index needs Python 3.11 or newer (this is {sys.version_info.major}.{sys.version_info.minor})")

import argparse
import json
import subprocess
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "tools"))  # -I drops the script dir from sys.path

import build_index as bi  # noqa: E402

THIS_REPO = "Eastsidegunn/meetko-plugins"


def local(row: dict) -> bool:
    return row["repo"].lower() == THIS_REPO.lower()


def facts(text: str, folder: str, owner: str, at: str | None = None) -> dict:
    """Manifest facts; a command path must be a file Git tracks (in the index, or at commit `at`):
    a build output that is only on this disk is not in the archive users install."""
    f = bi.validate_manifest(text, owner)
    command = bi.tomllib.loads(text)["run"]["command"]
    prog = (command if isinstance(command, list) else [command])[0].replace("\\", "/")
    if "/" in prog:
        path = f"{folder}/{prog}"
        tracked = git("ls-tree", "--name-only", at, path) if at else git("ls-files", "--", path)
        if not tracked.strip():
            raise bi.Rejected(f"run.command {prog!r} is not a committed file: a compiled plugin must commit its binary (meetko never builds at install)")
    return f


def check() -> tuple[list[dict], list[str]]:
    doc = json.loads((ROOT / "sources.json").read_text(encoding="utf-8"))
    rows = bi.load_sources(json.dumps({"plugins": doc.get("plugins")}))
    unlisted = doc.get("unlisted", {})
    if not isinstance(unlisted, dict) or not all(isinstance(k, str) and isinstance(v, str) and v for k, v in unlisted.items()):
        raise bi.FetchFailed('"unlisted" must map a folder name to the reason it is not listed')
    errs = []
    for r in rows:
        if not local(r):
            continue
        if not r["path"]:
            errs.append(f"{r['repo']}: the repository root is not a plugin; name a folder")
            continue
        folder = ROOT / r["path"]
        try:
            facts((folder / "meetko.toml").read_text(encoding="utf-8"), r["path"], THIS_REPO.split("/")[0])
        except FileNotFoundError:
            errs.append(f"{r['path']}: no meetko.toml")
        except bi.Rejected as e:
            errs.append(f"{r['path']}: {e}")
    listed = {r["path"] for r in rows if local(r)}
    for d in sorted(p for p in ROOT.iterdir() if (p / "meetko.toml").is_file()):
        if d.name in listed and d.name in unlisted:
            errs.append(f"{d.name}: both listed and unlisted")
        elif d.name not in listed and d.name not in unlisted:
            errs.append(f"{d.name}: a plugin folder that is neither in sources.json plugins nor in unlisted")
    return rows, errs


def git(*args: str) -> str:
    return subprocess.run(["git", "-C", str(ROOT), *args], check=True, capture_output=True, text=True).stdout


def write(rows: list[dict], sha: str, ref: str, out: Path) -> list[str]:
    sha = git("rev-parse", "--verify", f"{sha}^{{commit}}").strip()
    if git("ls-tree", "--name-only", sha, ".gitattributes").strip():
        raise SystemExit(".gitattributes exists at that commit: export-subst could change the archive; use the workflow")
    owner = THIS_REPO.split("/")[0]
    meta = {"full_name": THIS_REPO, "stargazers_count": 0, "pushed_at": ""}
    old = json.loads(out.read_text(encoding="utf-8")).get("plugins", []) if out.exists() else []
    plugins, notes = [], []
    for r in rows:
        if not local(r):
            kept = [p for p in old if p["repo"].lower() == r["repo"].lower() and p.get("path", "") == r["path"]]
            plugins += kept
            notes.append(f"{bi.where(r)}: {'kept from the current index' if kept else 'not in the current index; the workflow adds it'}")
            continue
        try:
            text = git("show", f"{sha}:{r['path']}/meetko.toml")
            plugins.append(bi.make_entry(meta, r["ref"] or ref, sha, facts(text, r["path"], owner, sha), r["path"]))
        except subprocess.CalledProcessError:
            raise SystemExit(f"{r['path']}: no meetko.toml at {sha}") from None
        except bi.Rejected as e:
            raise SystemExit(f"{r['path']} at {sha}: {e}") from None
    doc = {"generated": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "plugins": plugins}
    errs = bi.validate_index(doc)
    if errs:
        raise SystemExit("refusing to write an invalid index: " + "; ".join(errs))
    out.write_text(json.dumps(doc, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return notes + [f"wrote {out.name}: {len(plugins)} plugin(s) at {sha}"]


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--sha", help="write index.json for this repo's folders at this commit (must be pushed to main)")
    ap.add_argument("--ref", default="main", help="the ref shown for entries without their own (default: main)")
    ap.add_argument("--out", default=str(ROOT / "index.json"))
    a = ap.parse_args()
    try:
        rows, errs = check()
    except (bi.FetchFailed, ValueError) as e:
        print(f"sources.json: {e}", file=sys.stderr)
        return 1
    for e in errs:
        print(f"error: {e}", file=sys.stderr)
    if errs:
        return 1
    if not a.sha:
        print(f"ok: {len(rows)} listed", file=sys.stderr)
        return 0
    for n in write(rows, a.sha, a.ref, Path(a.out)):
        print(n, file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
